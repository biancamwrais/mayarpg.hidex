<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:fitsSystemWindows="true">


    <TextView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MAYA"
        android:textColor="@color/login_text"
        android:textSize="48sp"
        android:textStyle="normal"
        android:letterSpacing="0.25"
        android:fontFamily="sans-serif-light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="120dp" />

    <View
        android:id="@+id/divLogo"
        android:layout_width="120dp"
        android:layout_height="1dp"
        android:background="@color/primary_light"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Maya Yamamoto"
        android:textColor="@color/login_text"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/divLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fisioterapia &amp; RPG"
        android:textColor="@color/primary_light"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <LinearLayout
        android:id="@+id/boxEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_login_input"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvTagline"
        android:layout_marginTop="48dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_email"
            app:tint="@color/primary_light" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/login_email"
            android:textColor="@color/login_text"
            android:textColorHint="@color/login_text_secondary"
            android:inputType="textEmailAddress"
            android:background="@null"
            android:paddingStart="12dp"
            android:autofillHints="emailAddress" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/boxSenha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_login_input"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/boxEmail"
        android:layout_marginTop="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/primary_light" />

        <EditText
            android:id="@+id/etSenha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/login_senha"
            android:textColor="@color/login_text"
            android:textColorHint="@color/login_text_secondary"
            android:inputType="textPassword"
            android:background="@null"
            android:paddingStart="12dp" />

        <ImageView
            android:id="@+id/ivToggleSenha"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_eye"
            app:tint="@color/primary_light"
            android:padding="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEsqueceu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_esqueceu"
        android:textColor="@color/primary_light"
        android:textSize="13sp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/boxSenha"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnEntrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_entrar"
        android:textColor="@color/azul_escuro"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="@color/primary_light"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="20dp"
        android:paddingVertical="14dp"
        style="?android:attr/borderlessButtonStyle"
        android:background="@drawable/bg_btn_entrar"
        app:layout_constraintTop_toBottomOf="@id/tvEsqueceu" />


    <LinearLayout
        android:id="@+id/divisorOu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/btnEntrar">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/login_text_secondary"
            android:alpha="0.5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_ou"
            android:textColor="@color/login_text_secondary"
            android:layout_marginHorizontal="16dp"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/login_text_secondary"
            android:alpha="0.5" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/boxCadastro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/divisorOu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_nao_tem_conta"
            android:textColor="@color/login_text" />

        <TextView
            android:id="@+id/tvCadastrar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_cadastre_se"
            android:textColor="@color/primary_light"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVersao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_versao"
        android:textColor="@color/login_text_secondary"
        android:textSize="11sp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/primary_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
