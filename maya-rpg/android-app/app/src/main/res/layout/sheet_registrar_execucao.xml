<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/reg_titulo"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnFechar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tile_primary_light"
                android:padding="14dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvNomeEx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alongamento Cervical"
                    android:textColor="@color/primary_dark"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvCategoriaEx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alongamento"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp" />
            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reg_nivel_dor"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="20dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <SeekBar
                    android:id="@+id/sliderDor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10"
                    android:progress="0"
                    android:progressTint="@color/primary"
                    android:thumbTint="@color/primary"
                    android:layout_toStartOf="@+id/tvDorValor" />

                <TextView
                    android:id="@+id/tvDorValor"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_circle_coral" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/reg_sem_dor"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reg_dor_intensa"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reg_observacoes"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/etObs"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="@string/reg_obs_hint"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:gravity="top|start"
                android:padding="10dp"
                android:background="@drawable/bg_input_outlined"
                android:layout_marginTop="6dp"
                android:inputType="textMultiLine|textCapSentences"
                android:textSize="13sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reg_instrucoes"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/tvInstrucoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />
        </LinearLayout>
    </ScrollView>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/surface">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reg_confirmar"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>
</LinearLayout>