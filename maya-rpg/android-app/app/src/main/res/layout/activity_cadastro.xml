<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_titulo"
            android:textColor="@color/login_text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_subtitulo"
            android:textColor="@color/login_text_secondary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <LinearLayout
            android:id="@+id/boxNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitulo">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_person" app:tint="@color/primary_light" />
            <EditText android:id="@+id/etNome"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/cadastro_nome"
                android:textColor="@color/login_text"
                android:textColorHint="@color/login_text_secondary"
                android:inputType="textPersonName|textCapWords"
                android:background="@null" android:paddingStart="12dp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/boxEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/boxNome">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_email" app:tint="@color/primary_light" />
            <EditText android:id="@+id/etEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/login_email"
                android:textColor="@color/login_text"
                android:textColorHint="@color/login_text_secondary"
                android:inputType="textEmailAddress"
                android:background="@null" android:paddingStart="12dp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/boxCpf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/boxEmail">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_calendar" app:tint="@color/primary_light" />
            <EditText android:id="@+id/etCpf"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/cadastro_cpf"
                android:textColor="@color/login_text"
                android:textColorHint="@color/login_text_secondary"
                android:inputType="number"
                android:background="@null" android:paddingStart="12dp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/boxTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/boxCpf">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_phone" app:tint="@color/primary_light" />
            <EditText android:id="@+id/etTelefone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/cadastro_telefone"
                android:textColor="@color/login_text"
                android:textColorHint="@color/login_text_secondary"
                android:inputType="phone"
                android:background="@null" android:paddingStart="12dp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/boxData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/boxTelefone">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_calendar" app:tint="@color/primary_light" />
            <EditText android:id="@+id/etData"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/cadastro_data_nascimento"
                android:textColor="@color/login_text"
                android:textColorHint="@color/login_text_secondary"
                android:inputType="number"
                android:background="@null" android:paddingStart="12dp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/boxSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/boxData">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_lock" app:tint="@color/primary_light" />
            <EditText android:id="@+id/etSenha"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_senha_min"
                android:textColor="@color/login_text"
                android:textColorHint="@color/login_text_secondary"
                android:inputType="textPassword"
                android:background="@null" android:paddingStart="12dp" />
            <ImageView android:id="@+id/ivToggleSenha"
                android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_eye" app:tint="@color/primary_light" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/boxConfSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_login_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/boxSenha">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_lock" app:tint="@color/primary_light" />
            <EditText android:id="@+id/etConfSenha"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_confirmar_senha"
                android:textColor="@color/login_text"
                android:textColorHint="@color/login_text_secondary"
                android:inputType="textPassword"
                android:background="@null" android:paddingStart="12dp" />
            <ImageView android:id="@+id/ivToggleConfSenha"
                android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_eye" app:tint="@color/primary_light" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/boxLgpd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_login_input"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/boxConfSenha">
            <CheckBox android:id="@+id/cbLgpd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/primary_light" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cadastro_lgpd"
                android:textColor="@color/login_text"
                android:textSize="13sp" />
        </LinearLayout>

        <Button android:id="@+id/btnCriar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_btn"
            android:textColor="@color/azul_escuro"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:background="@drawable/bg_btn_entrar"
            android:layout_marginTop="20dp"
            android:paddingVertical="14dp"
            app:layout_constraintTop_toBottomOf="@id/boxLgpd" />

        <LinearLayout
            android:id="@+id/boxLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnCriar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/cadastro_ja_tem"
                android:textColor="@color/login_text" />
            <TextView android:id="@+id/tvLogin"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/cadastro_faca_login"
                android:textColor="@color/primary_light"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_copyright"
            android:textColor="@color/login_text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/boxLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
